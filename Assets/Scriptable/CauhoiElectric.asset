  m_Script: {fileID: 11500000, guid: 12d719606d7937c4b9683265c0dd0c0c, type: 3}
  m_Name: CauhoiElectric
  m_EditorClassIdentifier: 
  TextQuestion: "C\xE1ch x\u1EED l\xFD an to\xE0n nh\u1EA5t cho tuy\u1EBFn c\xE1p
    \u0111i\u1EC7n n\xE0y l\xE0 g\xEC?"
  TextListAnswer:
  - "[A] B\xE1o k\u1EF9 thu\u1EADt \u0111i\u1EC7n ng\u1EAFt ngu\u1ED3n c\u1EA5p,
    b\u1ECDc c\xE1ch \u0111i\u1EC7n v\xE0 treo c\xE1p l\xEAn c\u1ED9t cao. "
  - "[B] D\xF9ng g\u1EADy g\u1ED7 d\xE0i kh\u1EC1u cu\u1ED9n c\xE1p ra kh\u1ECFi
    v\u0169ng n\u01B0\u1EDBc."
  - "[C] \u0110\u1EB7t m\u1ED9t t\u1EA5m v\xE1n g\u1ED7 l\xEAn v\u0169ng n\u01B0\u1EDBc
    \u0111\u1EC3 b\u01B0\u1EDBc qua."
  correctAnwer: 0
