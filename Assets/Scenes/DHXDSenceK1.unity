  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. S\u1EED d\u1EE5ng n\xFAt A/B \u0111\u1EC3 b\u1EADt tia ray v\xE0 d\xF9ng
    n\xF3 \u0111\u1EC3 t\u01B0\u01A1ng t\xE1c v\u1EDBi m\u1ECDi v\u1EADt.\r\n2. S\u1EED
    d\u1EE5ng n\xFAt Trigger \u0111\u1EC3 t\u01B0\u01A1ng t\xE1c v\u1EDBi b\u1EA3ng
    c\xE2u h\u1ECFi v\xE0 c\xE1c b\u1EA3ng th\xF4ng tin.\r\n3. S\u1EED d\u1EE5ng
    n\xFAt Grip (ph\u1EA7n th\xE2n tay c\u1EA7m) \u0111\u1EC3 t\u01B0\u01A1ng t\xE1c
    v\u1EDBi c\xE1c v\u1EADt th\u1EC3, di chuy\u1EC3n v\xE0 l\xE0m trong su\u1ED1t
    t\u01B0\u1EDDng.\r\n4. Ri\xEAng tay c\u1EA7m tr\xE1i, n\xFAt Grip s\u1EBD gi\xFAp
    b\u1EA1n b\u1EADt \u0111\u01B0\u1EE3c giao di\u1EC7n l\xE0m trong t\u1ED5ng th\u1EC3
    c\u1EE7a c\xE1c t\u1EA7ng v\xE0 c\u1EA3 t\xF2a nh\xE0.\r\n5. L\u01B0u \xFD: \u0110\u1EC3
    xem b\u1EA3ng th\xF4ng s\u1ED1 BIM ch\u1EC9 c\xF3 th\u1EC3 d\xF9ng n\xFAt Grip
    c\u1EE7a tay c\u1EA7m ph\u1EA3i!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b1306a6cba6fd0c4798b6846680ee567, type: 2}
